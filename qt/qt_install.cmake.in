cmake_minimum_required(VERSION 3.26)
if (NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Debug)
endif ()
execute_process(COMMAND "@CMAKE_COMMAND@" --install . --config "${CMAKE_BUILD_TYPE}" RESULT_VARIABLE QT_RET WORKING_DIRECTORY "@QT_BUILD_DIR@" OUTPUT_VARIABLE MSG ERROR_VARIABLE MSG)

if (QT_RET)
  message(FATAL_ERROR "Qt install failed: ${MSG}\n")
endif (QT_RET)

if ("@QT_XMIN_ENABLED@" STREQUAL "ON")
  execute_process(
    COMMAND "@CMAKE_COMMAND@" -DQT_AUDIT_ROOT=@CMAKE_BUNDLE_INSTALL_PREFIX@
      -P "@CMAKE_CURRENT_BINARY_DIR@/qt_xmin_audit.cmake"
    RESULT_VARIABLE QT_AUDIT_RET
  )
  if (QT_AUDIT_RET)
    message(FATAL_ERROR "Installed Qt Xmin dependency audit failed")
  endif ()
endif ()

message("Qt install succeeded: ${MSG}\n")

