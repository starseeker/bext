+// Keep the write margin separate from storage so shrinking a viewport
+// never truncates text already in the history buffer.
+void Fl_Terminal::wrap_columns(int val) {
+  wrap_columns_ = val > 0 ? val : 0;
+}
+
+int Fl_Terminal::wrap_columns(void) const {
+  return wrap_columns_ > 0 ? MIN(wrap_columns_, disp_cols()) : disp_cols();
+}
