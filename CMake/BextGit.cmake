# Shared repository selection for configure-time and bootstrap submodule updates.
# Keep .gitmodules canonical and scope all overrides to the Git process tree.
include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)
cmake_policy(SET CMP0057 NEW)

set(BEXT_REPOSITORY_ROOT "https://github.com/BRL-CAD" CACHE STRING
  "Repository URL or local mirror directory containing bext's dependency repositories")
# Keep a relative filename relative to the source tree, even when supplied as an
# untyped -D argument (declaring FILEPATH directly would resolve it against cwd).
if (DEFINED BEXT_GIT_REMAP AND NOT BEXT_GIT_REMAP STREQUAL "")
  get_filename_component(BEXT_GIT_REMAP "${BEXT_GIT_REMAP}" ABSOLUTE
    BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
endif ()
set(BEXT_GIT_REMAP "${BEXT_GIT_REMAP}" CACHE FILEPATH "Repository mapping file" FORCE)
set(BEXT_SUBMODULE_URLS "" CACHE STRING "Semicolon-separated submodule-path=repository overrides")
set(BEXT_GIT_URL_MAP "" CACHE STRING "Semicolon-separated original-prefix=replacement-prefix overrides")

function(_bext_git_destination out_url out_local value base)
  set(local FALSE)
  set(url "${value}")
  if (url MATCHES "^file://")
    set(local TRUE)
  elseif (url MATCHES "^[A-Za-z]:[/\\\\]" OR
      NOT (url MATCHES "^[A-Za-z][A-Za-z0-9+.-]*://" OR url MATCHES "^[^/]+:.+"))
    set(local TRUE)
    string(REPLACE "\\" "/" url "${url}")
    set(trailing_slash FALSE)
    if (url MATCHES "/$")
      set(trailing_slash TRUE)
    endif ()
    if (WIN32 OR NOT url MATCHES "^[A-Za-z]:/")
      get_filename_component(url "${url}" ABSOLUTE BASE_DIR "${base}")
    endif ()
    if (trailing_slash AND NOT url MATCHES "/$")
      string(APPEND url "/")
    endif ()
    # Encode native paths once; existing file URLs are already URL encoded.
    string(REPLACE "%" "%25" url "${url}")
    string(REPLACE " " "%20" url "${url}")
    string(REPLACE "#" "%23" url "${url}")
    string(REPLACE "?" "%3F" url "${url}")
    string(REPLACE "=" "%3D" url "${url}")
    if (url MATCHES "^[A-Za-z]:/")
      set(url "file:///${url}")
    elseif (url MATCHES "^//")
      set(url "file:${url}")
    else ()
      set(url "file://${url}")
    endif ()
  endif ()
  set(${out_url} "${url}" PARENT_SCOPE)
  set(${out_local} "${local}" PARENT_SCOPE)
endfunction()

function(bext_git_repository_root out_root out_local)
  if (BEXT_REPOSITORY_ROOT STREQUAL "" OR BEXT_REPOSITORY_ROOT MATCHES "[;\r\n]")
    message(FATAL_ERROR "BEXT_REPOSITORY_ROOT must be a repository URL or local mirror directory without semicolons or newlines")
  endif ()
  _bext_git_destination(root local "${BEXT_REPOSITORY_ROOT}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  if (NOT root MATCHES "^file:///*$")
    string(REGEX REPLACE "/+$" "" root "${root}")
    string(APPEND root "/")
  else ()
    set(root "file:///")
  endif ()
  set(${out_root} "${root}" PARENT_SCOPE)
  set(${out_local} "${local}" PARENT_SCOPE)
endfunction()

# Each input layer is stored separately so duplicate entries are errors, while
# an inline entry can intentionally replace a file entry. Hash keys to avoid
# interpreting punctuation in URLs or submodule paths as CMake syntax.
function(_bext_git_entry layer section line base origin)
  string(FIND "${line}" "=" separator)
  if (separator LESS 1 OR line MATCHES "[;\r\n]")
    message(FATAL_ERROR "${origin}: expected key = value without semicolons or newlines")
  endif ()
  string(SUBSTRING "${line}" 0 ${separator} key)
  math(EXPR start "${separator} + 1")
  string(SUBSTRING "${line}" ${start} -1 value)
  string(STRIP "${key}" key)
  string(STRIP "${value}" value)
  if (key STREQUAL "" OR value STREQUAL "")
    message(FATAL_ERROR "${origin}: mapping key and value must be nonempty")
  endif ()
  string(SHA256 id "${key}")
  set(property "BEXT_GIT_${layer}_${section}_${id}")
  get_property(exists GLOBAL PROPERTY "${property}_KEY" SET)
  if (exists)
    message(FATAL_ERROR "${origin}: duplicate mapping key in ${section}")
  endif ()
  _bext_git_destination(value local "${value}" "${base}")
  set_property(GLOBAL APPEND PROPERTY "BEXT_GIT_${layer}_${section}" "${id}")
  set_property(GLOBAL PROPERTY "${property}_KEY" "${key}")
  set_property(GLOBAL PROPERTY "${property}_VALUE" "${value}")
  set_property(GLOBAL PROPERTY "${property}_LOCAL" "${local}")
  set_property(GLOBAL PROPERTY "${property}_ORIGIN" "${origin}")
endfunction()

function(_bext_git_read_remap filename)
  if (NOT EXISTS "${filename}" OR IS_DIRECTORY "${filename}")
    message(FATAL_ERROR "BEXT_GIT_REMAP: cannot read mapping file ${filename}")
  endif ()
  if (NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${filename}")
  endif ()
  get_filename_component(base "${filename}" DIRECTORY)
  file(READ "${filename}" remaining)
  # Accept a UTF-8 BOM as well as CRLF. Parse by line without converting the
  # file to a CMake list: semicolons and unmatched brackets must not merge lines.
  string(ASCII 239 187 191 bom)
  string(REGEX REPLACE "^${bom}" "" remaining "${remaining}")
  set(section "")
  set(number 0)
  while (NOT remaining STREQUAL "")
    math(EXPR number "${number} + 1")
    string(FIND "${remaining}" "\n" end)
    if (end EQUAL -1)
      set(line "${remaining}")
      set(remaining "")
    else ()
      string(SUBSTRING "${remaining}" 0 ${end} line)
      math(EXPR next "${end} + 1")
      string(SUBSTRING "${remaining}" ${next} -1 remaining)
    endif ()
    string(STRIP "${line}" line)
    if (line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif ()
    set(origin "${filename}:${number}")
    if (line MATCHES "^\\[")
      if (line STREQUAL "[submodules]")
        set(section submodules)
      elseif (line STREQUAL "[urls]")
        set(section urls)
      else ()
        message(FATAL_ERROR "${origin}: expected [submodules] or [urls]")
      endif ()
    elseif (section STREQUAL "")
      message(FATAL_ERROR "${origin}: mapping must follow [submodules] or [urls]")
    else ()
      _bext_git_entry(FILE "${section}" "${line}" "${base}" "${origin}")
    endif ()
  endwhile ()
endfunction()

function(_bext_git_read_submodules source)
  find_program(GIT_EXECUTABLE git)
  if (NOT GIT_EXECUTABLE)
    message(FATAL_ERROR "Need git to resolve submodule paths in repository mappings")
  endif ()
  execute_process(COMMAND "${GIT_EXECUTABLE}" config --file "${source}/.gitmodules"
    --get-regexp "^submodule\\..*\\.(path|url)$"
    RESULT_VARIABLE result OUTPUT_VARIABLE records ERROR_VARIABLE error)
  if (NOT result STREQUAL "0")
    message(FATAL_ERROR "Unable to read submodule paths and URLs from ${source}/.gitmodules")
  endif ()
  string(REPLACE "\n" ";" records "${records}")
  set(names)
  foreach(record IN LISTS records)
    if (record MATCHES "^submodule\\.(.*)\\.(path|url)[ \t]+(.+)$")
      set(name "${CMAKE_MATCH_1}")
      set(field "${CMAKE_MATCH_2}")
      set(value "${CMAKE_MATCH_3}")
      string(SHA256 id "${name}")
      set("${id}_${field}" "${value}")
      list(APPEND names "${id}")
    endif ()
  endforeach()
  list(REMOVE_DUPLICATES names)
  foreach(id IN LISTS names)
    if (DEFINED ${id}_path AND DEFINED ${id}_url)
      string(SHA256 path_id "${${id}_path}")
      set_property(GLOBAL PROPERTY "BEXT_GIT_CANONICAL_${path_id}" "${${id}_url}")
    endif ()
  endforeach()
endfunction()

function(_bext_git_rule source destination local origin priority)
  string(SHA256 id "${source}")
  get_property(old_priority GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_PRIORITY")
  get_property(old_value GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_VALUE")
  if (old_priority AND old_priority EQUAL priority AND NOT old_value STREQUAL destination)
    get_property(old_origin GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_ORIGIN")
    message(FATAL_ERROR "${origin}: conflicting mappings for the same canonical URL (also ${old_origin})")
  endif ()
  if (NOT old_priority)
    set_property(GLOBAL APPEND PROPERTY BEXT_GIT_RULES "${id}")
  endif ()
  set_property(GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_KEY" "${source}")
  set_property(GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_VALUE" "${destination}")
  set_property(GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_LOCAL" "${local}")
  set_property(GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_ORIGIN" "${origin}")
  set_property(GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_PRIORITY" "${priority}")
endfunction()

function(_bext_git_redact out value)
  string(REGEX REPLACE "(://)[^/]*@" "\\1<redacted>@" value "${value}")
  string(REGEX REPLACE "[?#].*$" "?<redacted>" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(_bext_git_initialize)
  get_filename_component(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if (NOT BEXT_GIT_REMAP STREQUAL "")
    _bext_git_read_remap("${BEXT_GIT_REMAP}")
  endif ()
  foreach(section urls submodules)
    if (section STREQUAL "urls")
      set(option BEXT_GIT_URL_MAP)
    else ()
      set(option BEXT_SUBMODULE_URLS)
    endif ()
    foreach(entry IN LISTS ${option})
      _bext_git_entry(INLINE "${section}" "${entry}" "${source}" "${option}")
    endforeach()
  endforeach()

  bext_git_repository_root(root root_local)
  _bext_git_rule("https://github.com/BRL-CAD/" "${root}" "${root_local}" BEXT_REPOSITORY_ROOT 1)
  # Validate *all* path keys, including entries replaced by inline settings.
  get_property(file_paths GLOBAL PROPERTY BEXT_GIT_FILE_submodules)
  get_property(inline_paths GLOBAL PROPERTY BEXT_GIT_INLINE_submodules)
  if (file_paths OR inline_paths)
    _bext_git_read_submodules("${source}")
    foreach(layer FILE INLINE)
      get_property(ids GLOBAL PROPERTY "BEXT_GIT_${layer}_submodules")
      foreach(id IN LISTS ids)
        get_property(known GLOBAL PROPERTY "BEXT_GIT_CANONICAL_${id}" SET)
        if (NOT known)
          get_property(origin GLOBAL PROPERTY "BEXT_GIT_${layer}_submodules_${id}_ORIGIN")
          message(FATAL_ERROR "${origin}: unknown submodule path; use an exact path from .gitmodules")
        endif ()
      endforeach()
    endforeach()
  endif ()
  foreach(section urls submodules)
    get_property(ids GLOBAL PROPERTY "BEXT_GIT_FILE_${section}")
    get_property(inline_ids GLOBAL PROPERTY "BEXT_GIT_INLINE_${section}")
    list(APPEND ids ${inline_ids})
    list(REMOVE_DUPLICATES ids)
    foreach(id IN LISTS ids)
      if (id IN_LIST inline_ids)
        set(layer INLINE)
      else ()
        set(layer FILE)
      endif ()
      set(property "BEXT_GIT_${layer}_${section}_${id}")
      foreach(field KEY VALUE LOCAL ORIGIN)
        get_property(${field} GLOBAL PROPERTY "${property}_${field}")
      endforeach()
      if (section STREQUAL "submodules")
        get_property(KEY GLOBAL PROPERTY "BEXT_GIT_CANONICAL_${id}")
        set(priority 3)
      else ()
        set(priority 2)
      endif ()
      _bext_git_rule("${KEY}" "${VALUE}" "${LOCAL}" "${ORIGIN}" "${priority}")
    endforeach()
  endforeach()

  set(any_local "${root_local}")
  set(explicit_remote FALSE)
  get_property(rules GLOBAL PROPERTY BEXT_GIT_RULES)
  foreach(id IN LISTS rules)
    get_property(local GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_LOCAL")
    get_property(priority GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_PRIORITY")
    if (local)
      set(any_local TRUE)
    elseif (priority GREATER 1)
      set(explicit_remote TRUE)
    endif ()
  endforeach()
  set(file_only FALSE)
  if (root_local AND NOT explicit_remote)
    set(file_only TRUE)
  endif ()
  set_property(GLOBAL PROPERTY BEXT_GIT_ANY_LOCAL "${any_local}")
  set_property(GLOBAL PROPERTY BEXT_GIT_FILE_ONLY "${file_only}")
  _bext_git_redact(display "${root}")
  message(STATUS "bext repository root: ${display}")
  if (file_only)
    message(STATUS "bext Git updates: file transport only, shallow recommendations disabled")
  elseif (any_local)
    message(STATUS "bext Git updates: mixed local/network transport, shallow recommendations disabled")
  else ()
    message(STATUS "bext Git updates: normal Git transport policy")
  endif ()
endfunction()

# Used by bootstrap LIST_ONLY as well as normal bootstrap. Rules, rather than
# guessed effective URLs, are displayed: user Git settings may also rewrite URLs.
function(bext_git_print_mappings)
  get_property(rules GLOBAL PROPERTY BEXT_GIT_RULES)
  foreach(id IN LISTS rules)
    get_property(key GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_KEY")
    get_property(value GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_VALUE")
    _bext_git_redact(key "${key}")
    _bext_git_redact(value "${value}")
    message(STATUS "bext Git mapping: ${key} -> ${value}")
  endforeach()
endfunction()

function(_bext_git_command out_command out_shallow)
  # Older Git versions silently ignore GIT_CONFIG_COUNT and would fetch from
  # the original URLs, so enforce support before starting any update.
  find_package(Git 2.31 REQUIRED)
  # Environment config avoids git -c's ambiguity when a destination contains '='.
  # Append to caller-provided config rather than losing its protocol policies.
  set(count 0)
  if (DEFINED ENV{GIT_CONFIG_COUNT} AND NOT "$ENV{GIT_CONFIG_COUNT}" STREQUAL "")
    set(count "$ENV{GIT_CONFIG_COUNT}")
    if (NOT count MATCHES "^[0-9]+$")
      message(FATAL_ERROR "GIT_CONFIG_COUNT must be a nonnegative integer")
    endif ()
  endif ()
  set(environment)
  get_property(rules GLOBAL PROPERTY BEXT_GIT_RULES)
  foreach(id IN LISTS rules)
    get_property(key GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_KEY")
    get_property(value GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_VALUE")
    get_property(priority GLOBAL PROPERTY "BEXT_GIT_RULE_${id}_PRIORITY")
    # Do not install an identity rule for the unchanged default root: it could
    # compete with a user's own Git rewrite of that same prefix.
    if (NOT key STREQUAL value OR priority GREATER 1)
      list(APPEND environment "GIT_CONFIG_KEY_${count}=url.${value}.insteadOf"
        "GIT_CONFIG_VALUE_${count}=${key}")
      math(EXPR count "${count} + 1")
    endif ()
  endforeach()
  list(APPEND environment "GIT_CONFIG_COUNT=${count}")
  set(git_command "${GIT_EXECUTABLE}")
  if (WIN32)
    list(APPEND git_command -c core.longpaths=true)
  endif ()
  get_property(any_local GLOBAL PROPERTY BEXT_GIT_ANY_LOCAL)
  get_property(file_only GLOBAL PROPERTY BEXT_GIT_FILE_ONLY)
  set(shallow_args)
  if (any_local)
    list(APPEND git_command -c protocol.file.allow=always)
    list(APPEND shallow_args --no-recommend-shallow)
  elseif (GIT_SHALLOW_CLONE)
    list(APPEND shallow_args --recommend-shallow)
  endif ()
  if (file_only)
    # Intersect with an existing caller allowlist, including an empty one.
    set(allowed file)
    if (DEFINED ENV{GIT_ALLOW_PROTOCOL})
      string(REPLACE ":" ";" caller_protocols "$ENV{GIT_ALLOW_PROTOCOL}")
      if (NOT "file" IN_LIST caller_protocols)
        set(allowed "")
      endif ()
    endif ()
    list(APPEND environment "GIT_ALLOW_PROTOCOL=${allowed}")
  endif ()
  list(PREPEND git_command "${CMAKE_COMMAND}" -E env ${environment} --)
  set(${out_command} "${git_command}" PARENT_SCOPE)
  set(${out_shallow} "${shallow_args}" PARENT_SCOPE)
endfunction()

function(bext_git_submodule_update working_directory)
  _bext_git_command(git_command shallow_args)
  execute_process(
    COMMAND ${git_command} submodule update --init --recursive ${shallow_args} ${ARGN}
    WORKING_DIRECTORY "${working_directory}"
    RESULT_VARIABLE git_result
  )
  if (NOT git_result STREQUAL "0")
    set(local_note "")
    get_property(file_only GLOBAL PROPERTY BEXT_GIT_FILE_ONLY)
    if (file_only)
      set(local_note " Only file transport is permitted; all required repositories and pinned commits must be available locally, including recursive submodules.")
    endif ()
    message(WARNING "Git submodule update failed in ${working_directory} (${git_result}).${local_note}")
  endif ()
endfunction()

_bext_git_initialize()
cmake_policy(POP)
