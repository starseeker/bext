include_guard(GLOBAL)
include(ExternalProject)

if (NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM)
  set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
endif ()

# BEXT_BUILD_ROLE is independent of packaging.  For example, LIEF is a native
# library needed by plief, while Eigen is a target compile-only dependency.
# Custom CONFIGURE_COMMAND wrappers must use BEXT_{HOST,TARGET}_CMAKE_ARGS
# themselves; ExternalProject's CMAKE_ARGS do not affect those commands.
function(ExternalProject_Add name)
  set(role TARGET)
  set(role_index -1)
  set(has_cmake_args FALSE)
  set(has_custom_configure FALSE)
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 1 ${last})
    if ("${ARGV${i}}" STREQUAL "BEXT_BUILD_ROLE")
      if (NOT role_index EQUAL -1 OR i EQUAL last)
        message(FATAL_ERROR "${name}: specify BEXT_BUILD_ROLE once, followed by HOST or TARGET")
      endif ()
      set(role_index ${i})
      math(EXPR value_index "${i} + 1")
      set(role "${ARGV${value_index}}")
    elseif ("${ARGV${i}}" STREQUAL "CMAKE_ARGS")
      set(has_cmake_args TRUE)
    elseif ("${ARGV${i}}" STREQUAL "CONFIGURE_COMMAND")
      set(has_custom_configure TRUE)
    endif ()
  endforeach ()
  if (NOT role MATCHES "^(HOST|TARGET)$")
    message(FATAL_ERROR "${name}: unknown BEXT_BUILD_ROLE '${role}'")
  endif ()

  # Bracket-quote individual original arguments to preserve empty commands,
  # lists, spaces, and generator expressions exactly as the caller supplied.
  set(ep_call "_ExternalProject_Add([==[${name}]==]")
  foreach(i RANGE 1 ${last})
    if (i EQUAL role_index OR (NOT role_index EQUAL -1 AND i EQUAL value_index))
      continue()
    endif ()
    string(APPEND ep_call " [==[${ARGV${i}}]==]")
    if ("${ARGV${i}}" STREQUAL "CMAKE_ARGS")
      string(APPEND ep_call " -C [==[${BEXT_${role}_CACHE}]==]"
        " [==[-DCMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM}]==]")
    endif ()
  endforeach ()
  if (NOT has_cmake_args AND NOT has_custom_configure)
    string(APPEND ep_call " CMAKE_ARGS -C [==[${BEXT_${role}_CACHE}]==]"
      " [==[-DCMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM}]==]")
  endif ()
  string(APPEND ep_call ")")
  cmake_language(EVAL CODE "${ep_call}")
  set_property(TARGET ${name} PROPERTY BEXT_BUILD_ROLE "${role}")
  if (NOT has_custom_configure)
    ExternalProject_Add_StepDependencies(${name} configure "${BEXT_${role}_CACHE}")
  endif ()
  if (TARGET ${name}-install)
    get_property(install_targets GLOBAL PROPERTY BEXT_INSTALL_TARGETS)
    list(APPEND install_targets ${name}-install)
    list(REMOVE_DUPLICATES install_targets)
    set_property(GLOBAL PROPERTY BEXT_INSTALL_TARGETS "${install_targets}")
  endif ()
endfunction()
