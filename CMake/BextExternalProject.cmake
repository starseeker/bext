include_guard(GLOBAL)
include(ExternalProject)

if (NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM)
  set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
endif ()

# Use one ExternalProject wrapper for build contexts and resource controls.
# Defining it twice would overwrite CMake's _ExternalProject_Add alias and
# recurse instead of invoking the original command.
function(ExternalProject_Add name)
  set(role TARGET)
  set(role_index -1)
  set(has_cmake_args FALSE)
  set(has_custom_configure FALSE)
  set(has_build_command FALSE)
  set(has_install_command FALSE)
  math(EXPR last "${ARGC} - 1")
  if (ARGC GREATER 1)
    foreach(i RANGE 1 ${last})
      if ("${ARGV${i}}" STREQUAL "BEXT_BUILD_ROLE")
        if (NOT role_index EQUAL -1 OR i EQUAL last)
          message(FATAL_ERROR "${name}: specify BEXT_BUILD_ROLE once, followed by HOST or TARGET")
        endif ()
        set(role_index ${i})
        math(EXPR value_index "${i} + 1")
        set(role "${ARGV${value_index}}")
      elseif ("${ARGV${i}}" STREQUAL "CMAKE_ARGS")
        set(has_cmake_args TRUE)
      elseif ("${ARGV${i}}" STREQUAL "CONFIGURE_COMMAND")
        set(has_custom_configure TRUE)
      elseif ("${ARGV${i}}" STREQUAL "BUILD_COMMAND")
        set(has_build_command TRUE)
      elseif ("${ARGV${i}}" STREQUAL "INSTALL_COMMAND")
        set(has_install_command TRUE)
      endif ()
    endforeach ()
  endif ()
  if (NOT role MATCHES "^(HOST|TARGET)$")
    message(FATAL_ERROR "${name}: unknown BEXT_BUILD_ROLE '${role}'")
  endif ()

  set(cmake_defaults " [==[-DCMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM}]==]")
  if (BEXT_${role}_CACHE)
    string(PREPEND cmake_defaults " -C [==[${BEXT_${role}_CACHE}]==]")
  endif ()
  if (BEXT_BUILD_JOBS)
    string(APPEND cmake_defaults
      " [==[-DBEXT_BUILD_JOBS=${BEXT_BUILD_JOBS}]==]"
      " [==[-DBEXT_LINK_JOBS=${BEXT_LINK_JOBS}]==]"
      " [==[-DCMAKE_PROJECT_INCLUDE=${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BextBuildResources.cmake]==]")
  endif ()

  # Preserve empty commands, lists, spaces and generator expressions exactly.
  # Custom configure scripts apply BEXT_{HOST,TARGET}_CMAKE_ARGS themselves.
  set(ep_call "_ExternalProject_Add([==[${name}]==]")
  if (ARGC GREATER 1)
    foreach(i RANGE 1 ${last})
      if (i EQUAL role_index OR (NOT role_index EQUAL -1 AND i EQUAL value_index))
        continue()
      endif ()
      if (BEXT_DISCARD_WORK AND i GREATER 1)
        math(EXPR previous "${i} - 1")
        if ("${ARGV${previous}}" STREQUAL "BUILD_ALWAYS")
          string(APPEND ep_call " OFF")
          continue()
        endif ()
      endif ()
      string(APPEND ep_call " [==[${ARGV${i}}]==]")
      if ("${ARGV${i}}" STREQUAL "CMAKE_ARGS")
        string(APPEND ep_call "${cmake_defaults}")
      endif ()
    endforeach ()
  endif ()
  if (NOT has_cmake_args AND NOT has_custom_configure)
    string(APPEND ep_call " CMAKE_ARGS${cmake_defaults}")
    set(has_cmake_args TRUE)
  endif ()
  if (has_cmake_args AND BEXT_BUILD_JOBS)
    foreach(step BUILD INSTALL)
      string(TOLOWER "${step}" lower_step)
      if (NOT has_${lower_step}_command)
        string(APPEND ep_call " ${step}_COMMAND [==[${CMAKE_COMMAND}]==] --build <BINARY_DIR> --parallel ${BEXT_BUILD_JOBS}")
        if (CMAKE_CONFIGURATION_TYPES)
          string(APPEND ep_call " --config [==[$<CONFIG>]==]")
        endif ()
        if (step STREQUAL "INSTALL")
          string(APPEND ep_call " --target install")
        endif ()
      endif ()
    endforeach ()
  endif ()
  # Serialize expensive outer phases; nested CMake builds use bounded pools.
  string(APPEND ep_call " USES_TERMINAL_CONFIGURE TRUE USES_TERMINAL_BUILD TRUE USES_TERMINAL_INSTALL TRUE")
  if (BEXT_DISCARD_WORK)
    string(APPEND ep_call " EXCLUDE_FROM_ALL TRUE")
  endif ()
  string(APPEND ep_call ")")
  cmake_language(EVAL CODE "${ep_call}")
  set_property(TARGET ${name} PROPERTY BEXT_BUILD_ROLE "${role}")
  set_property(GLOBAL APPEND PROPERTY BEXT_EXTERNAL_PROJECTS "${name}")
  if (NOT has_custom_configure AND BEXT_${role}_CACHE)
    ExternalProject_Add_StepDependencies(${name} configure "${BEXT_${role}_CACHE}")
  endif ()
  if (TARGET ${name}-install)
    get_property(install_targets GLOBAL PROPERTY BEXT_INSTALL_TARGETS)
    list(APPEND install_targets ${name}-install)
    list(REMOVE_DUPLICATES install_targets)
    set_property(GLOBAL PROPERTY BEXT_INSTALL_TARGETS "${install_targets}")
  endif ()
endfunction()
