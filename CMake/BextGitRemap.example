[urls]
# Optional URL-prefix rules also reach recursive submodules.
# Preserve trailing slashes when replacing directory prefixes.
# https://github.com/BRL-CAD/ = https://mirror.example.org/brlcad/
# https://other.example.org/vendor/ = ../mirrors/vendor/
