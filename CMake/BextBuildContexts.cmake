# Build tools execute on the host; libraries and shipped programs use the
# target toolchain.  Keep this distinction independent of install/noinstall.
include_guard(GLOBAL)
set(_BEXT_CONTEXT_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# Use bracket quoting in generated cache files.  In particular, do not flatten
# CMake lists or reinterpret backslashes in SDK paths as escape sequences.
function(bext_cache_entry out name value)
  set(eq "=")
  string(FIND "${value}" "]${eq}]" closing)
  while (NOT closing EQUAL -1)
    string(APPEND eq "=")
    string(FIND "${value}" "]${eq}]" closing)
  endwhile ()
  set(${out} "set(${name} [${eq}[${value}]${eq}] CACHE STRING \"bext build context\" FORCE)\n" PARENT_SCOPE)
endfunction()

function(bext_find_host_program name)
  if (CMAKE_CROSSCOMPILING)
    set(CMAKE_PREFIX_PATH "${BEXT_HOST_INSTALL_PREFIX};${BEXT_HOST_PREFIX_PATH}")
    set(CMAKE_INSTALL_PREFIX "${BEXT_HOST_INSTALL_PREFIX}")
    set(CMAKE_STAGING_PREFIX "")
    set(CMAKE_PROGRAM_PATH "")
    set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH FALSE)
  endif ()
  find_program(${name} ${ARGN} NO_CMAKE_FIND_ROOT_PATH)
  set(${name} "${${name}}" PARENT_SCOPE)
endfunction()

function(bext_write_context_file path contents)
  file(WRITE "${path}.tmp" "${contents}")
  file(COPY_FILE "${path}.tmp" "${path}" ONLY_IF_DIFFERENT)
  file(REMOVE "${path}.tmp")
endfunction()

macro(bext_initialize_build_contexts)
  set(BEXT_TOOLCHAIN_VARIABLES "" CACHE STRING
    "Additional toolchain cache variables forwarded to target CMake builds")
  set(BEXT_HOST_TOOLCHAIN_FILE "" CACHE FILEPATH
    "Optional toolchain file for native build tools")
  set(BEXT_HOST_PREFIX_PATH "" CACHE STRING
    "Native dependency prefixes used when cross compiling")

  # Preserve native builds' existing output layout.  Cross builds put native
  # libraries and programs below host/ so target compile-only assets can still
  # occupy noinstall without an architecture collision.
  if (CMAKE_CROSSCOMPILING)
    set(_bext_host_prefix "${CMAKE_NOBUNDLE_INSTALL_PREFIX}/host")
  else ()
    set(_bext_host_prefix "${CMAKE_NOBUNDLE_INSTALL_PREFIX}")
  endif ()
  set(BEXT_HOST_INSTALL_PREFIX "${_bext_host_prefix}" CACHE PATH
    "Installation prefix for native build tools and their dependencies")

  if (CMAKE_CROSSCOMPILING)
    if (BEXT_HOST_INSTALL_PREFIX STREQUAL CMAKE_BUNDLE_INSTALL_PREFIX)
      message(FATAL_ERROR "Native tools and target libraries need different installation prefixes")
    endif ()
    # Explicit package hints into our target installation must be searchable
    # with FIND_ROOT_PATH_MODE_{LIBRARY,INCLUDE,PACKAGE}=ONLY.
    list(APPEND CMAKE_FIND_ROOT_PATH
      "${CMAKE_BUNDLE_INSTALL_PREFIX}" "${CMAKE_NOBUNDLE_INSTALL_PREFIX}")
    list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
  endif ()

  set(BEXT_TARGET_CACHE "${CMAKE_BINARY_DIR}/CMakeFiles/bext-target-cache.cmake")
  set(_bext_target_cache "# Generated by bext.  Target context for ExternalProject builds.\n")
  set(_bext_forward_vars
    CMAKE_TOOLCHAIN_FILE CMAKE_SYSTEM_NAME CMAKE_SYSTEM_VERSION
    CMAKE_SYSTEM_PROCESSOR CMAKE_SYSROOT CMAKE_SYSROOT_COMPILE CMAKE_SYSROOT_LINK
    CMAKE_STAGING_PREFIX CMAKE_FIND_ROOT_PATH CMAKE_PREFIX_PATH
    CMAKE_FIND_ROOT_PATH_MODE_PROGRAM CMAKE_FIND_ROOT_PATH_MODE_LIBRARY
    CMAKE_FIND_ROOT_PATH_MODE_INCLUDE CMAKE_FIND_ROOT_PATH_MODE_PACKAGE
    CMAKE_FIND_USE_PACKAGE_REGISTRY CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY
    CMAKE_TRY_COMPILE_TARGET_TYPE CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    CMAKE_CROSSCOMPILING_EMULATOR CMAKE_MSVC_RUNTIME_LIBRARY
    CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
    CMAKE_AR CMAKE_RANLIB CMAKE_LINKER CMAKE_NM CMAKE_OBJCOPY CMAKE_OBJDUMP
    CMAKE_STRIP CMAKE_MT
    ${CMAKE_TRY_COMPILE_PLATFORM_VARIABLES} ${BEXT_TOOLCHAIN_VARIABLES})
  foreach(_bext_lang C CXX ASM RC)
    foreach(_bext_suffix COMPILER COMPILER_ARG1 COMPILER_TARGET
        COMPILER_EXTERNAL_TOOLCHAIN COMPILER_AR COMPILER_RANLIB
        COMPILER_LAUNCHER FLAGS FLAGS_DEBUG FLAGS_RELEASE
        FLAGS_RELWITHDEBINFO FLAGS_MINSIZEREL)
      list(APPEND _bext_forward_vars CMAKE_${_bext_lang}_${_bext_suffix})
    endforeach ()
  endforeach ()
  foreach(_bext_kind EXE SHARED MODULE STATIC)
    foreach(_bext_config "" _DEBUG _RELEASE _RELWITHDEBINFO _MINSIZEREL)
      list(APPEND _bext_forward_vars CMAKE_${_bext_kind}_LINKER_FLAGS${_bext_config})
    endforeach ()
  endforeach ()
  list(REMOVE_DUPLICATES _bext_forward_vars)
  foreach(_bext_var IN LISTS _bext_forward_vars)
    if (DEFINED ${_bext_var})
      # Setting SYSTEM_NAME explicitly makes even a native CMake build report
      # CMAKE_CROSSCOMPILING.  Forward it only for actual cross builds.
      if (NOT CMAKE_CROSSCOMPILING AND _bext_var MATCHES "^CMAKE_SYSTEM_")
        continue()
      endif ()
      set(_bext_value "${${_bext_var}}")
      if (_bext_var STREQUAL "CMAKE_TOOLCHAIN_FILE" AND _bext_value)
        # CMake resolves relative toolchains against the build tree first.
        if (EXISTS "${CMAKE_BINARY_DIR}/${_bext_value}")
          get_filename_component(_bext_value "${CMAKE_BINARY_DIR}/${_bext_value}" ABSOLUTE)
        else ()
          get_filename_component(_bext_value "${_bext_value}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        endif ()
      endif ()
      bext_cache_entry(_bext_entry "${_bext_var}" "${_bext_value}")
      string(APPEND _bext_target_cache "${_bext_entry}")
    endif ()
  endforeach ()
  bext_write_context_file("${BEXT_TARGET_CACHE}" "${_bext_target_cache}")
  set(BEXT_TARGET_CMAKE_ARGS -C "${BEXT_TARGET_CACHE}")

  if (CMAKE_CROSSCOMPILING)
    if (BEXT_HOST_TOOLCHAIN_FILE)
      get_filename_component(BEXT_HOST_TOOLCHAIN_FILE "${BEXT_HOST_TOOLCHAIN_FILE}"
        ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
      if (NOT EXISTS "${BEXT_HOST_TOOLCHAIN_FILE}")
        message(FATAL_ERROR "Native toolchain does not exist: ${BEXT_HOST_TOOLCHAIN_FILE}")
      endif ()
    else ()
      find_program(BEXT_HOST_C_COMPILER NAMES cc gcc clang cl
        NO_CMAKE_FIND_ROOT_PATH REQUIRED)
      find_program(BEXT_HOST_CXX_COMPILER NAMES c++ g++ clang++ cl
        NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    endif ()

    set(BEXT_HOST_CACHE "${CMAKE_BINARY_DIR}/CMakeFiles/bext-host-cache.cmake")
    set(_bext_host_cache "# Generated by bext.  Native context for build tools.\n")
    # CMake initializes flags from the environment before configuring a child.
    # Do not let target settings (including CMAKE_TOOLCHAIN_FILE from the
    # environment) turn a native helper into a Windows executable.
    string(APPEND _bext_host_cache
      "foreach(v CC CXX RC AR RANLIB CFLAGS CXXFLAGS CPPFLAGS LDFLAGS\n"
      "    CMAKE_TOOLCHAIN_FILE CMAKE_PREFIX_PATH PKG_CONFIG_PATH\n"
      "    PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR CPATH C_INCLUDE_PATH\n"
      "    CPLUS_INCLUDE_PATH LIBRARY_PATH)\n  unset(ENV{\${v}})\nendforeach()\n")
    foreach(_bext_lang C CXX)
      if (BEXT_HOST_${_bext_lang}_COMPILER)
        bext_cache_entry(_bext_entry CMAKE_${_bext_lang}_COMPILER "${BEXT_HOST_${_bext_lang}_COMPILER}")
        string(APPEND _bext_host_cache "${_bext_entry}")
      endif ()
    endforeach ()
    if (BEXT_HOST_TOOLCHAIN_FILE)
      bext_cache_entry(_bext_entry CMAKE_TOOLCHAIN_FILE "${BEXT_HOST_TOOLCHAIN_FILE}")
      string(APPEND _bext_host_cache "${_bext_entry}")
    else ()
      # Some projects inspect a defined toolchain file before project(), even
      # when its value is empty.  Native builds have no such file to inspect.
      string(APPEND _bext_host_cache
        "unset(CMAKE_TOOLCHAIN_FILE CACHE)\nunset(CMAKE_TOOLCHAIN_FILE)\n")
    endif ()
    bext_cache_entry(_bext_entry CMAKE_PREFIX_PATH "${BEXT_HOST_INSTALL_PREFIX};${BEXT_HOST_PREFIX_PATH}")
    string(APPEND _bext_host_cache "${_bext_entry}")
    string(APPEND _bext_host_cache "set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF CACHE BOOL \"\" FORCE)\n")
    bext_write_context_file("${BEXT_HOST_CACHE}" "${_bext_host_cache}")

    # Obtain the native compiler/platform information in its own CMake project.
    # The probe links and runs a program, so an accidentally selected cross
    # compiler cannot silently supply unusable build tools.
    set(_bext_probe_dir "${CMAKE_BINARY_DIR}/CMakeFiles/bext-host-probe")
    execute_process(COMMAND "${CMAKE_COMMAND}"
      -S "${_BEXT_CONTEXT_MODULE_DIR}/HostProbe" -B "${_bext_probe_dir}"
      -G "${CMAKE_GENERATOR}" -C "${BEXT_HOST_CACHE}"
      "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}"
      RESULT_VARIABLE _bext_probe_result OUTPUT_VARIABLE _bext_probe_log ERROR_VARIABLE _bext_probe_error)
    if (NOT _bext_probe_result EQUAL 0)
      message(FATAL_ERROR "Native compiler validation failed. Set BEXT_HOST_C_COMPILER and "
        "BEXT_HOST_CXX_COMPILER, or BEXT_HOST_TOOLCHAIN_FILE.\n${_bext_probe_log}\n${_bext_probe_error}")
    endif ()
    include("${_bext_probe_dir}/host-info.cmake")
  else ()
    set(BEXT_HOST_CACHE "${BEXT_TARGET_CACHE}")
    set(BEXT_HOST_C_COMPILER "${CMAKE_C_COMPILER}")
    set(BEXT_HOST_CXX_COMPILER "${CMAKE_CXX_COMPILER}")
    set(BEXT_HOST_EXECUTABLE_SUFFIX "${CMAKE_EXECUTABLE_SUFFIX}")
    set(BEXT_HOST_MSVC "${MSVC}")
  endif ()
  set(BEXT_HOST_CMAKE_ARGS -C "${BEXT_HOST_CACHE}")
endmacro()
