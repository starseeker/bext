include_guard(GLOBAL)

# Tcl's configure scripts sometimes execute "$CC" as a single pathname.
# Preserve compiler targets and sysroots in a launcher rather than flattening
# the compiler invocation into an environment variable containing arguments.
function(bext_mingw_launcher path)
  set(script "#!/bin/sh\nexec")
  foreach(arg IN LISTS ARGN)
    string(REPLACE "'" "'\"'\"'" quoted "${arg}")
    string(APPEND script " '${quoted}'")
  endforeach ()
  string(APPEND script " \"$@\"\n")
  bext_write_context_file("${path}" "${script}")
  file(CHMOD "${path}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endfunction()

function(bext_mingw_context)
  if (NOT WIN32 OR MSVC OR CMAKE_HOST_WIN32)
    message(FATAL_ERROR "The MinGW configure adapter requires a Windows GNU target and a Unix host")
  endif ()
  get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if (_multi)
    message(FATAL_ERROR "The Tcl/Tk MinGW adapter requires a single-configuration generator")
  endif ()
  if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
    set(BEXT_MINGW_ARCH x86_64)
    set(BEXT_MINGW_BITS --enable-64bit)
  elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|ARM64|arm64)$")
    set(BEXT_MINGW_ARCH aarch64)
    set(BEXT_MINGW_BITS --enable-64bit=arm64)
  elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86|X86)$")
    set(BEXT_MINGW_ARCH i686)
    set(BEXT_MINGW_BITS --disable-64bit)
  else ()
    message(FATAL_ERROR "Unknown Windows processor for Tcl/Tk configure: ${CMAKE_SYSTEM_PROCESSOR}")
  endif ()
  set(BEXT_MINGW_HOST "${BEXT_MINGW_ARCH}-w64-mingw32")
  execute_process(COMMAND "${BEXT_HOST_C_COMPILER}" -dumpmachine
    OUTPUT_VARIABLE BEXT_MINGW_BUILD OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _bext_dump_result)
  if (NOT _bext_dump_result EQUAL 0 OR NOT BEXT_MINGW_BUILD MATCHES "^[A-Za-z0-9_.+-]+$")
    message(FATAL_ERROR "The native compiler must report a build triple with -dumpmachine")
  endif ()
  set(BEXT_MINGW_TOOLS "${CMAKE_BINARY_DIR}/CMakeFiles/bext-mingw-tools")
  file(MAKE_DIRECTORY "${BEXT_MINGW_TOOLS}")
  foreach(_lang C CXX)
    set(_command "${CMAKE_${_lang}_COMPILER}")
    separate_arguments(_arg1 NATIVE_COMMAND "${CMAKE_${_lang}_COMPILER_ARG1}")
    list(APPEND _command ${_arg1})
    foreach(_option TARGET EXTERNAL_TOOLCHAIN)
      if (CMAKE_${_lang}_COMPILER_${_option})
        separate_arguments(_args NATIVE_COMMAND
          "${CMAKE_${_lang}_COMPILE_OPTIONS_${_option}}${CMAKE_${_lang}_COMPILER_${_option}}")
        list(APPEND _command ${_args})
      endif ()
    endforeach ()
    if (CMAKE_SYSROOT_COMPILE OR CMAKE_SYSROOT_LINK)
      message(FATAL_ERROR "The Tcl/Tk MinGW adapter currently requires one CMAKE_SYSROOT for compiling and linking")
    endif ()
    if (CMAKE_SYSROOT)
      list(APPEND _command "--sysroot=${CMAKE_SYSROOT}")
    endif ()
    bext_mingw_launcher("${BEXT_MINGW_TOOLS}/${_lang}" ${_command})
  endforeach ()
  string(TOUPPER "${CMAKE_BUILD_TYPE}" _config)
  separate_arguments(_rc_flags NATIVE_COMMAND "${CMAKE_RC_FLAGS} ${CMAKE_RC_FLAGS_${_config}}")
  bext_mingw_launcher("${BEXT_MINGW_TOOLS}/windres" "${CMAKE_RC_COMPILER}" ${_rc_flags})
  bext_mingw_launcher("${BEXT_MINGW_TOOLS}/tclsh" "${CMAKE_COMMAND}" -E env
    --unset=TCL_LIBRARY --unset=TCLLIBPATH --unset=TK_LIBRARY
    --unset=ITCL_LIBRARY --unset=ITK_LIBRARY "${BEXT_HOST_TCLSH}")
  set(BEXT_MINGW_CFLAGS "${CMAKE_C_FLAGS} ${CMAKE_C_FLAGS_${_config}}")
  set(BEXT_MINGW_CXXFLAGS "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${_config}}")
  # Autotools exposes one LDFLAGS for both executable and shared-library links.
  set(BEXT_MINGW_LDFLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${CMAKE_SHARED_LINKER_FLAGS_${_config}}")
  if (NOT "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_${_config}}" STREQUAL BEXT_MINGW_LDFLAGS)
    string(APPEND BEXT_MINGW_LDFLAGS " ${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_${_config}}")
  endif ()
  find_program(BEXT_MINGW_MAKE NAMES gmake make NO_CMAKE_FIND_ROOT_PATH REQUIRED)
  execute_process(COMMAND "${BEXT_MINGW_MAKE}" --version
    OUTPUT_VARIABLE _make_version ERROR_VARIABLE _make_error RESULT_VARIABLE _make_result)
  if (NOT _make_result EQUAL 0 OR NOT _make_version MATCHES "GNU Make")
    message(FATAL_ERROR "The Tcl/Tk MinGW adapter requires GNU make; set BEXT_MINGW_MAKE to its native executable")
  endif ()
  foreach(_path "${CMAKE_BINARY_DIR}" "${CMAKE_BUNDLE_INSTALL_PREFIX}" "${CMAKE_CURRENT_SOURCE_DIR}")
    if (_path MATCHES "[ ;]")
      message(FATAL_ERROR "The Tcl/Tk MinGW adapter needs source, build and install paths without spaces or semicolons")
    endif ()
  endforeach ()
  set(BEXT_MINGW_ENV "${CMAKE_BINARY_DIR}/CMakeFiles/bext-mingw-env.cmake")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BextMingwEnv.cmake.in" "${BEXT_MINGW_ENV}" @ONLY)
  set(BEXT_MINGW_ENV "${BEXT_MINGW_ENV}" PARENT_SCOPE)
  set(BEXT_MINGW_INPUTS "${BEXT_MINGW_ENV}"
    "${BEXT_MINGW_TOOLS}/C" "${BEXT_MINGW_TOOLS}/CXX"
    "${BEXT_MINGW_TOOLS}/windres" "${BEXT_MINGW_TOOLS}/tclsh" PARENT_SCOPE)
endfunction()
