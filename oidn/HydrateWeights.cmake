foreach(required_var OIDN_WEIGHTS_DIR OIDN_WEIGHTS_REVISION OIDN_WEIGHTS_MEDIA_ROOT)
  if (NOT DEFINED ${required_var} OR "${${required_var}}" STREQUAL "")
    message(FATAL_ERROR "${required_var} is required")
  endif ()
endforeach()

string(LENGTH "${OIDN_WEIGHTS_REVISION}" revision_length)
if (NOT revision_length EQUAL 40 OR
    NOT OIDN_WEIGHTS_REVISION MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "OIDN_WEIGHTS_REVISION must be a full Git commit hash")
endif ()

file(GLOB weight_files LIST_DIRECTORIES false "${OIDN_WEIGHTS_DIR}/*.tza")
if (NOT weight_files)
  message(FATAL_ERROR "No OIDN weight files found in ${OIDN_WEIGHTS_DIR}")
endif ()

string(REGEX REPLACE "/+$" "" media_root "${OIDN_WEIGHTS_MEDIA_ROOT}")
foreach(weight_file IN LISTS weight_files)
  file(READ "${weight_file}" pointer LIMIT 512)
  if (NOT pointer MATCHES "^version https://git-lfs.github.com/spec/v1")
    continue()
  endif ()
  if (NOT pointer MATCHES "oid sha256:([0-9a-fA-F]+)")
    message(FATAL_ERROR "Malformed Git LFS pointer: ${weight_file}")
  endif ()
  set(expected_hash "${CMAKE_MATCH_1}")
  string(LENGTH "${expected_hash}" expected_hash_length)
  if (NOT expected_hash_length EQUAL 64)
    message(FATAL_ERROR "Malformed Git LFS hash in ${weight_file}")
  endif ()
  if (NOT pointer MATCHES "size ([0-9]+)")
    message(FATAL_ERROR "Git LFS pointer has no size: ${weight_file}")
  endif ()
  set(expected_size "${CMAKE_MATCH_1}")

  get_filename_component(weight_name "${weight_file}" NAME)
  set(download_file "${weight_file}.download")
  set(download_url "${media_root}/${OIDN_WEIGHTS_REVISION}/${weight_name}")
  message(STATUS "Downloading OIDN weight ${weight_name}")
  file(DOWNLOAD "${download_url}" "${download_file}"
    EXPECTED_HASH "SHA256=${expected_hash}"
    STATUS download_status
    TLS_VERIFY ON
  )
  list(GET download_status 0 download_result)
  list(GET download_status 1 download_error)
  if (NOT download_result EQUAL 0)
    file(REMOVE "${download_file}")
    message(FATAL_ERROR "Unable to download ${weight_name}: ${download_error}")
  endif ()
  file(SIZE "${download_file}" actual_size)
  if (NOT actual_size EQUAL expected_size)
    file(REMOVE "${download_file}")
    message(FATAL_ERROR
      "Downloaded ${weight_name} has size ${actual_size}, expected ${expected_size}")
  endif ()
  file(RENAME "${download_file}" "${weight_file}")
endforeach()
